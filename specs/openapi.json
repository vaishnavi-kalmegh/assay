{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "OrderCreate": {
        "properties": {
          "product_id": {
            "exclusiveMinimum": 0.0,
            "title": "Product Id",
            "type": "integer"
          },
          "quantity": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Quantity",
            "type": "integer"
          }
        },
        "required": [
          "product_id",
          "quantity"
        ],
        "title": "OrderCreate",
        "type": "object"
      },
      "ProductCategory": {
        "enum": [
          "book",
          "game",
          "stationery"
        ],
        "title": "ProductCategory",
        "type": "string"
      },
      "ProductCreate": {
        "properties": {
          "category": {
            "$ref": "#/components/schemas/ProductCategory"
          },
          "name": {
            "maxLength": 40,
            "minLength": 3,
            "title": "Name",
            "type": "string"
          },
          "price": {
            "exclusiveMinimum": 0.0,
            "maximum": 10000.0,
            "title": "Price",
            "type": "number"
          }
        },
        "required": [
          "name",
          "price",
          "category"
        ],
        "title": "ProductCreate",
        "type": "object"
      },
      "StockUpdate": {
        "properties": {
          "quantity": {
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Quantity",
            "type": "integer"
          }
        },
        "required": [
          "quantity"
        ],
        "title": "StockUpdate",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "A local demo API with explicit validation rules for API testing.",
    "title": "assay Demo API",
